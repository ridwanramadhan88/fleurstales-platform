{
  "manifestVersion": 5,
  "id": "com.fleurstales.audiotrackexporter",
  "name": "Audio Track Exporter",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.1.0"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "audioTrackExporterPanel",
      "label": { "default": "Audio Track Exporter" },
      "minimumSize": { "width": 260, "height": 320 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 520 },
      "preferredFloatingSize": { "width": 360, "height": 560 },
      "icons": [
        { "width": 23, "height": 23, "path": "icons/panel.svg", "scale": [1, 2], "theme": ["all"] }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.svg",
      "scale": [1, 2],
      "theme": ["all"],
      "species": ["pluginList"]
    }
  ]
}

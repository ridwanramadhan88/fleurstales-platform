{
  "name": "fleurstales-platform",
  "version": "1.0.5",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild-style-plugin": {
      "glob": "13.0.6"
    }
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "npm run build:storefront && npm run build:os",
    "build:storefront": "npm run build --workspace=fleurstales-storefront",
    "build:os": "npm run build --workspace=fleurstales-os",
    "check": "npm run check:i18n && npm run check:supabase-security && npm run check:v36 && npm run check:v37 && npm run check:v38 && npm run check:v311 && npm run check:attendance-simplification && npm run check:admin-workflow && npm run check:shared-parity && npm run check:storefront && npm run check:os",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:shared-parity": "node scripts/check-shared-parity.mjs",
    "check:storefront": "npm run check --workspace=fleurstales-storefront",
    "check:os": "npm run check --workspace=fleurstales-os",
    "check:supabase-security": "node scripts/check-supabase-security.mjs",
    "check:v36": "node scripts/check-v36-integrity.mjs",
    "check:v37": "node scripts/check-v37-authority.mjs",
    "check:v38": "node scripts/check-v38-florist-readonly.mjs",
    "check:v311": "node scripts/check-v311-hardening.mjs",
    "check:attendance-simplification": "node scripts/check-attendance-simplification.mjs",
    "check:admin-workflow": "node scripts/check-admin-workflow.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "glob": "13.0.6",
    "vitest": "4.1.10"
  }
}
